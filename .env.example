# ローカル開発ではこのファイルをコピーして .dev.vars を作成する。
# Basic認証情報、APIキー、サービスアカウント秘密鍵には実値をコミットしない。
TENANT_ID=REPLACE_WITH_TENANT_ID
PBKDF2_ITERATIONS=20000
ALLOW_WEAK_PASSWORD_HASH=true
MAX_OCR_PAGES_PER_MONTH=120
MAX_GEMINI_CALLS_PER_MONTH=720
MAX_CHECK_RUNS_PER_APPLICATION=5
ALLOW_DATA_RESET=true
BASIC_AUTH_USERNAME=REPLACE_WITH_BASIC_AUTH_USERNAME
BASIC_AUTH_PASSWORD=REPLACE_WITH_BASIC_AUTH_PASSWORD
OCR_PIPELINE_MODE=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GOOGLE_CLOUD_PROJECT_ID=REPLACE_WITH_GOOGLE_CLOUD_PROJECT_ID
DOCUMENT_AI_LOCATION=REPLACE_WITH_DOCUMENT_AI_LOCATION
DOCUMENT_AI_PROCESSOR_ID=REPLACE_WITH_DOCUMENT_AI_PROCESSOR_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=REPLACE_WITH_GOOGLE_SERVICE_ACCOUNT_EMAIL
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=REPLACE_WITH_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
